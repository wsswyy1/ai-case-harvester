# OpenAI-compatible classifier. Required for classification.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. Used only as a bearer token for the official public GitHub Search API
# (rate limits). Never used to read private repositories.
GITHUB_TOKEN=

# Optional. Pending-intake only. Leave blank to disable push and use JSON export.
# Do not put a live token here. The app reads USECASECN_INGEST_TOKEN from the
# environment and must never log it.
USECASECN_API_URL=
USECASECN_INGEST_TOKEN=

# SQLite path. The data/ directory is created at runtime.
DATABASE_PATH=./data/harvester.db

# Comma-separated public subreddits for the Reddit collector (no login).
# Default: LocalLLaMA,ChatGPTCoding,SideProject
REDDIT_SUBREDDITS=

# Optional per-API request spacing in milliseconds. Defaults are conservative
# (HN 1000, GitHub 6500, Reddit 6500, usecasecn 1000). On HTTP 429 the app
# stops calling that API for the rest of the run regardless of these values.
HN_DELAY_MS=
GITHUB_DELAY_MS=
REDDIT_DELAY_MS=
USECASECN_DELAY_MS=
