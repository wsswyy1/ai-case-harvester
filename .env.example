# OpenAI-compatible classifier. Required for classification.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. Used only as a bearer token for the official public GitHub Search API
# (rate limits). Never used to read private repositories.
GITHUB_TOKEN=

# Optional. Pending-intake only. Leave blank to disable push and use JSON export.
# Do not put a live token here. The app reads USECASECN_INGEST_TOKEN from the
# environment and must never log it.
USECASECN_API_URL=
USECASECN_INGEST_TOKEN=

# SQLite path. The data/ directory is created at runtime.
DATABASE_PATH=./data/harvester.db
